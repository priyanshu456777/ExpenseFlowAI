# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/expenseflow-ai

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Password Reset
RESET_TOKEN_EXPIRES_MINUTES=15

# Email (Nodemailer - SMTP)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=ExpenseFlow AI <onboarding@resend.dev>

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200

# File uploads
MAX_FILE_UPLOAD_MB=5
