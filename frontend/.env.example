# In local development, leave this blank — Vite's dev server proxies /api
# requests to your local backend (see vite.config.js), so no URL is needed.
#
# In production, set this to your deployed backend's full API URL, e.g.:
# VITE_API_URL=https://expenseflow-ai-backend.onrender.com/api/v1
VITE_API_URL=
